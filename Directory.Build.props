<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      默认按 invariant 模式构建以获得稳定的字符串比较与排序行为；
      但 WPF 的数据绑定会在运行时解析区域设置，invariant 模式下所有文化均为空，
      绑定引擎会抛出「找不到对应的非中性文化」而中断。
      因此 WPF 工程（XBear.App 与其测试工程）必须关闭该开关。
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <Product>小熊模拟器</Product>
    <Company>Xiaoxiong Emulator</Company>

    <!--
      版本契约规范：产品版本与规格版本是独立递增序列，禁止代码中硬编码任何版本字符串。
      构建期由 MSBuild 属性函数直接读取 spec/spec/version.json 中的 product.version，
      无契约文件时通过 0.1.0 兜底，并支持 CI 或命令行通过 -p:ProductVersion=... 显式覆盖。
    -->
    <_SpecVersionJson Condition="'$(_SpecVersionJson)' == '' and '$(XBEAR_SPEC_VERSION_JSON)' != ''">$(XBEAR_SPEC_VERSION_JSON)</_SpecVersionJson>
    <_SpecVersionJson Condition="'$(_SpecVersionJson)' == '' and Exists('$(MSBuildThisFileDirectory)spec\spec\version.json')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)spec\spec\version.json'))</_SpecVersionJson>
    <_SpecVersionJson Condition="'$(_SpecVersionJson)' == '' and Exists('$(MSBuildThisFileDirectory)..\spec\version.json')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\spec\version.json'))</_SpecVersionJson>
    <_SpecVersionJsonText Condition="'$(_SpecVersionJson)' != '' and Exists('$(_SpecVersionJson)')">$([System.IO.File]::ReadAllText('$(_SpecVersionJson)'))</_SpecVersionJsonText>

    <_ProductVersionFromContract Condition="'$(_SpecVersionJsonText)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_SpecVersionJsonText)', '\"product\"\s*:\s*\{[^{}]*\"version\"\s*:\s*\"([0-9A-Za-z\.\-]+)\"').Groups[1].Value)</_ProductVersionFromContract>

    <ProductVersion Condition="'$(ProductVersion)' == '' and '$(_ProductVersionFromContract)' != ''">$(_ProductVersionFromContract)</ProductVersion>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>

    <Version>$(ProductVersion)</Version>
    <AssemblyVersion>$(ProductVersion).0</AssemblyVersion>
    <FileVersion>$(ProductVersion).0</FileVersion>
    <!-- 关闭 .NET SDK 默认追加的完整源修订哈希，保证 AssemblyInformationalVersion 严格遵循契约的 {productVersion}+{commitShort} 格式 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(ProductVersion)+unknown</InformationalVersion>
    <AssemblyInformationalVersion Condition="'$(AssemblyInformationalVersion)' == ''">$(InformationalVersion)</AssemblyInformationalVersion>

    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>