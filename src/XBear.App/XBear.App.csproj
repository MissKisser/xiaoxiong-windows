<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\XBear.Core\XBear.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <!--
      JSON Schema 求值器随 App 层引入，而非 Core 层。
      Core 刻意不引用任何 Schema 库，ISchemaEvaluator 的实现由引用了 Schema 库的装配层注入。
      版本与测试工程保持一致，确保两端对同一份契约的判定口径相同。
    -->
    <PackageReference Include="JsonSchema.Net" Version="7.3.3" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!--
      WPF 的数据绑定在运行时解析区域设置，invariant 模式下所有文化均为空，
      绑定引擎会抛出「找不到对应的非中性文化」并中断，启动阶段即失败。
      因此界面层必须使用真实的全球化数据。
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    共享规格以 submodule 形式位于 ../../spec/，其下真实内容为 spec/。
    SpecLoader.Default 以 AppContext.BaseDirectory/spec 为契约根，
    设计令牌、术语表与三份 Schema 均从该位置读取，缺一即启动失败，
    因此契约必须随程序一并落到输出目录。
  -->
  <ItemGroup>
    <SpecDir Include="$(MSBuildThisFileDirectory)..\..\spec\spec\**\*" />
  </ItemGroup>

  <Target Name="CopySpecToOutput" BeforeTargets="Build">
    <Copy SourceFiles="@(SpecDir)"
          DestinationFolder="$(OutDir)spec\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="$(OutDir)spec\**\*.json" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
