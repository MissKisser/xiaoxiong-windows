<Window x:Class="XBear.App.Views.ExposureConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认暴露级别" Height="320" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource FadeInOnLoad}">
            <StackPanel Margin="{DynamicResource Token.Space.Xl}">
                <StackPanel Style="{StaticResource SectionHeader}">
                    <Image Source="{StaticResource Icon.Exposure}" Style="{StaticResource SectionHeaderIcon}" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding ExposureTerm}"
                               Margin="{DynamicResource Space.Margin.BesideIcon}" />
                </StackPanel>

                <Border Style="{StaticResource DialogCard}">
                    <TextBlock Text="{Binding ConfirmationText}" TextWrapping="Wrap" />
                </Border>

                <!-- 选 public 时必须显式警示，风险不得只靠图标暗示。 -->
                <Border Style="{StaticResource RiskBanner}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Icon.Exposure}"
                               Width="{DynamicResource Icon.Size.Sm}"
                               Height="{DynamicResource Icon.Size.Sm}"
                               VerticalAlignment="Center" />
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource Token.Color.Text.Inverse}"
                                   FontWeight="{DynamicResource Token.Weight.Bold}"
                                   Margin="{DynamicResource Space.Margin.BesideIcon}"
                                   Text="该操作会把实例端口暴露给同网段乃至公网设备。若实例持有 Root 权限或已登录账号，风险显著放大。" />
                    </StackPanel>
                </Border>

                <!-- 未勾选时确认按钮保持禁用，形成阻断式确认。 -->
                <CheckBox Content="{Binding AcknowledgementText}" IsChecked="{Binding IsAcknowledged, Mode=TwoWay}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{DynamicResource Space.Margin.Section}">
                    <Button Content="{Binding CancelText}" Click="OnCancel" />
                    <Button Content="{Binding ConfirmText}" Click="OnConfirm" IsEnabled="{Binding IsAcknowledged}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>