<Window x:Class="XBear.App.Views.ApplicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="760" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Token.Color.Surface.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部信息栏与刷新按钮 -->
        <Border Grid.Row="0"
                Style="{DynamicResource Card}"
                Margin="{DynamicResource Token.Space.Md}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="{StaticResource Icon.Application}"
                       Style="{StaticResource SectionHeaderIcon}"
                       ToolTip="应用" />

                <TextBlock Grid.Column="1"
                           Text="{Binding WindowTitle}"
                           FontWeight="{DynamicResource Token.Weight.Medium}"
                           VerticalAlignment="Center"
                           Margin="{DynamicResource Space.Margin.BesideIcon}" />

                <Button Grid.Column="2"
                        Content="刷新列表"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 安装应用包区域 -->
        <Border Grid.Row="1"
                Style="{DynamicResource Card}"
                Margin="{DynamicResource Token.Space.Md}">
            <StackPanel>
                <TextBlock Text="安装应用包" Style="{StaticResource SectionTitle}" Margin="0" />

                <!-- APK 路径选择 -->
                <Grid Margin="{DynamicResource Token.Space.Sm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="应用包路径："
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding SelectedApkPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             Margin="{DynamicResource Token.Space.Sm}" />
                    <Button Grid.Column="2"
                            Content="浏览..."
                            Command="{Binding BrowseApkCommand}"
                            Style="{StaticResource SecondaryButton}"
                            VerticalAlignment="Center" />
                </Grid>

                <!-- 应用包名输入与安装按钮 -->
                <Grid Margin="{DynamicResource Token.Space.Sm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="应用包名："
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding PackageNameInput, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             Margin="{DynamicResource Token.Space.Sm}" />
                    <Button Grid.Column="2"
                            Content="安装应用包"
                            Command="{Binding InstallCommand}"
                            VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="正在安装应用包，请稍候..."
                           Style="{StaticResource HintText}"
                           Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}"
                           Margin="{DynamicResource Token.Space.Sm}" />
            </StackPanel>
        </Border>

        <!-- 应用列表与操作区域 -->
        <Border Grid.Row="2"
                Style="{DynamicResource Card}"
                Margin="{DynamicResource Token.Space.Md}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="{DynamicResource Token.Space.Sm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="已安装应用列表"
                               Style="{StaticResource SectionTitle}"
                               Margin="0"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Content="拉起应用"
                            Command="{Binding LaunchCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="{DynamicResource Token.Space.Sm}" />

                    <Button Grid.Column="2"
                            Content="卸载应用"
                            Command="{Binding UninstallCommand}"
                            Style="{StaticResource DangerButton}"
                            Margin="{DynamicResource Token.Space.Sm}" />
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Applications}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="{DynamicResource Token.Color.Surface.Raised}"
                         BorderBrush="{DynamicResource Token.Color.Surface.Overlay}"
                         BorderThickness="1"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource Card}" Margin="{DynamicResource Token.Space.Sm}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 第一行：包名与安装状态胶囊 -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding PackageName}"
                                                   FontWeight="{DynamicResource Token.Weight.Medium}"
                                                   VerticalAlignment="Center" />

                                        <Border Grid.Column="1" Style="{StaticResource StatusPill}">
                                            <TextBlock Text="{Binding InstallStateText}" />
                                        </Border>
                                    </Grid>

                                    <!-- 第二行：版本名、版本号、主 ABI -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="{DynamicResource Token.Space.Sm}">
                                        <TextBlock Text="版本名：" Style="{StaticResource CaptionText}" Margin="0" />
                                        <TextBlock Text="{Binding VersionNameText}" Style="{StaticResource CaptionText}" Margin="0" />
                                        <TextBlock Text=" | 版本号：" Style="{StaticResource CaptionText}" Margin="{DynamicResource Space.Margin.BesideIcon}" />
                                        <TextBlock Text="{Binding VersionCodeText}" Style="{StaticResource CaptionText}" Margin="0" />
                                        <TextBlock Text=" | 主 ABI：" Style="{StaticResource CaptionText}" Margin="{DynamicResource Space.Margin.BesideIcon}" />
                                        <TextBlock Text="{Binding PrimaryCpuAbiText}" Style="{StaticResource CaptionText}" Margin="0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 底部操作结果提示 -->
        <Border Grid.Row="3"
                Margin="{DynamicResource Token.Space.Md}"
                Visibility="{Binding HasOperationResult, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasOperationFailure}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Token.Color.State.Danger}" />
                            <Setter Property="Padding" Value="{DynamicResource Token.Space.Md}" />
                            <Setter Property="CornerRadius" Value="{DynamicResource Token.Radius.Sm}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasOperationFailure}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Token.Color.Surface.Raised}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Token.Color.State.Success}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="{DynamicResource Token.Space.Md}" />
                            <Setter Property="CornerRadius" Value="{DynamicResource Token.Radius.Sm}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding LastOperationResultText}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
