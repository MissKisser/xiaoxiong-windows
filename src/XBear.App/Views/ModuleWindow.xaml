<Window x:Class="XBear.App.Views.ModuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="760" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Token.Color.Surface.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部信息栏与刷新按钮 -->
        <Border Grid.Row="0"
                Style="{DynamicResource Card}"
                Margin="{DynamicResource Token.Space.Md}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="{StaticResource Icon.Module}"
                       Style="{StaticResource SectionHeaderIcon}"
                       ToolTip="模块" />

                <TextBlock Grid.Column="1"
                           Text="{Binding WindowTitle}"
                           FontWeight="{DynamicResource Token.Weight.Medium}"
                           VerticalAlignment="Center"
                           Margin="{DynamicResource Space.Margin.BesideIcon}" />

                <Button Grid.Column="2"
                        Content="刷新列表"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 安装模块区域 -->
        <Border Grid.Row="1"
                Style="{DynamicResource Card}"
                Margin="{DynamicResource Token.Space.Md}">
            <StackPanel>
                <TextBlock Text="安装模块" Style="{StaticResource SectionTitle}" Margin="0" />

                <!-- 模块 ZIP 路径选择与安装按钮 -->
                <Grid Margin="{DynamicResource Token.Space.Sm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="模块文件："
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding SelectedZipPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             Margin="{DynamicResource Token.Space.Sm}" />
                    <Button Grid.Column="2"
                            Content="浏览..."
                            Command="{Binding BrowseZipCommand}"
                            Style="{StaticResource SecondaryButton}"
                            VerticalAlignment="Center" />
                    <Button Grid.Column="3"
                            Content="安装模块"
                            Command="{Binding InstallCommand}"
                            VerticalAlignment="Center"
                            Margin="{DynamicResource Token.Space.Sm}" />
                </Grid>

                <TextBlock Text="正在安装模块，请稍候..."
                           Style="{StaticResource HintText}"
                           Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}"
                           Margin="{DynamicResource Token.Space.Sm}" />
            </StackPanel>
        </Border>

        <!-- 模块列表与卸载操作区域 -->
        <Border Grid.Row="2"
                Style="{DynamicResource Card}"
                Margin="{DynamicResource Token.Space.Md}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="{DynamicResource Token.Space.Sm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="已安装模块列表"
                               Style="{StaticResource SectionTitle}"
                               Margin="0"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Content="卸载模块"
                            Command="{Binding UninstallCommand}"
                            Style="{StaticResource DangerButton}"
                            Margin="{DynamicResource Token.Space.Sm}" />
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Modules}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="{DynamicResource Token.Color.Surface.Raised}"
                         BorderBrush="{DynamicResource Token.Color.Surface.Overlay}"
                         BorderThickness="1"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource Card}" Margin="{DynamicResource Token.Space.Sm}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 第一行：模块标识与状态胶囊 -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Id}"
                                                   FontWeight="{DynamicResource Token.Weight.Medium}"
                                                   VerticalAlignment="Center" />

                                        <Border Grid.Column="1" Style="{StaticResource StatusPill}">
                                            <TextBlock Text="{Binding InstallStateText}" />
                                        </Border>
                                    </Grid>

                                    <!-- 第二行：实例内路径 -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding RemotePath}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="{DynamicResource Token.Space.Sm}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 底部操作结果提示 -->
        <Border Grid.Row="3"
                Margin="{DynamicResource Token.Space.Md}"
                Visibility="{Binding HasOperationResult, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasOperationFailure}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Token.Color.State.Danger}" />
                            <Setter Property="Padding" Value="{DynamicResource Token.Space.Md}" />
                            <Setter Property="CornerRadius" Value="{DynamicResource Token.Radius.Sm}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasOperationFailure}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Token.Color.Surface.Raised}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Token.Color.State.Success}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="{DynamicResource Token.Space.Md}" />
                            <Setter Property="CornerRadius" Value="{DynamicResource Token.Radius.Sm}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding LastOperationResultText}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
