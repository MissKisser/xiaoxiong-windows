<Window x:Class="XBear.App.Views.SnapshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="760" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Token.Color.Surface.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部信息栏与刷新按钮 -->
        <Border Grid.Row="0"
                Style="{DynamicResource Card}"
                Margin="{DynamicResource Token.Space.Md}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="{StaticResource Icon.Snapshot}"
                       Style="{StaticResource SectionHeaderIcon}"
                       ToolTip="快照" />

                <TextBlock Grid.Column="1"
                           Text="{Binding WindowTitle}"
                           FontWeight="{DynamicResource Token.Weight.Medium}"
                           VerticalAlignment="Center"
                           Margin="{DynamicResource Space.Margin.BesideIcon}" />

                <Button Grid.Column="2"
                        Content="刷新列表"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 创建快照区域：名称必填，备注可选 -->
        <Border Grid.Row="1"
                Style="{DynamicResource Card}"
                Margin="{DynamicResource Token.Space.Md}">
            <StackPanel>
                <TextBlock Text="{Binding CreateSnapshotText}" Style="{StaticResource SectionTitle}" Margin="0" />
                <TextBlock Text="{Binding CreateHintText}" Style="{StaticResource HintText}" />

                <Grid Margin="{DynamicResource Token.Space.Sm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="名称："
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding NewSnapshotName, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             Margin="{DynamicResource Token.Space.Sm}" />
                    <TextBlock Grid.Column="2"
                               Text="备注："
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}" />
                    <TextBox Grid.Column="3"
                             Text="{Binding NewSnapshotNote, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             Margin="{DynamicResource Token.Space.Sm}" />
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding CreateSnapshotText}"
                            Command="{Binding CreateCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 快照列表与恢复删除操作区域 -->
        <Border Grid.Row="2"
                Style="{DynamicResource Card}"
                Margin="{DynamicResource Token.Space.Md}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="{DynamicResource Token.Space.Sm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding SnapshotListTitle}"
                               Style="{StaticResource SectionTitle}"
                               Margin="0"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Content="{Binding RestoreSnapshotText}"
                            Command="{Binding RestoreCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="{DynamicResource Token.Space.Sm}" />
                    <Button Grid.Column="2"
                            Content="{Binding DeleteSnapshotText}"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource DangerButton}"
                            Margin="{DynamicResource Token.Space.Sm}" />
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Snapshots}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="{DynamicResource Token.Color.Surface.Raised}"
                         BorderBrush="{DynamicResource Token.Color.Surface.Overlay}"
                         BorderThickness="1"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="{DynamicResource Token.Space.Sm}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 第一行：快照标识与状态胶囊 -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayName}"
                                                   FontWeight="{DynamicResource Token.Weight.Medium}"
                                                   VerticalAlignment="Center" />

                                        <Border Grid.Column="1" Style="{StaticResource StatusPill}">
                                            <TextBlock Text="{Binding StateText}" />
                                        </Border>
                                    </Grid>

                                    <!-- 第二行：快照标识与创建时刻 -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding CreatedAtText}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="{DynamicResource Token.Space.Sm}" />

                                    <!-- 第三行：备注与父快照 -->
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="{Binding NoteText}" Style="{StaticResource CaptionText}" />
                                        <TextBlock Text="{Binding ParentText}" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 底部操作结果提示 -->
        <Border Grid.Row="3"
                Margin="{DynamicResource Token.Space.Md}"
                Visibility="{Binding HasOperationResult, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasOperationFailure}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Token.Color.State.Danger}" />
                            <Setter Property="Padding" Value="{DynamicResource Token.Space.Md}" />
                            <Setter Property="CornerRadius" Value="{DynamicResource Token.Radius.Sm}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasOperationFailure}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Token.Color.Surface.Raised}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Token.Color.State.Success}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="{DynamicResource Token.Space.Md}" />
                            <Setter Property="CornerRadius" Value="{DynamicResource Token.Radius.Sm}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding LastOperationResultText}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>