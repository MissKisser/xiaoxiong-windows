<Application x:Class="XBear.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XBear.App.Presentation"
             StartupUri="MainWindow.xaml">
    <!--
        StartupUri 在这里保留而不在 OnStartup 里重复建窗：OnStartup 负责注入
        DataContext 并在令牌写入后重建主窗口，而 StartupUri 承担 WPF 的初始建窗职责。
        两者职责不同，缺一则主窗口要么没有 DataContext，要么根本不出现。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <!-- 视觉取值一律引用设计令牌，XAML 内不出现字面量颜色、字号与间距。 -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource Token.Color.Surface.Base}" />
                <Setter Property="Foreground" Value="{DynamicResource Token.Color.Text.Primary}" />
                <Setter Property="FontFamily" Value="{DynamicResource Token.Font.Primary}" />
                <Setter Property="FontSize" Value="{DynamicResource Token.Font.Body}" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Token.Color.Text.Primary}" />
                <Setter Property="FontSize" Value="{DynamicResource Token.Font.Body}" />
                <Setter Property="Margin" Value="{DynamicResource Token.Thickness.Sm}" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Token.Color.Brand.Primary}" />
                <Setter Property="FontSize" Value="{DynamicResource Token.Font.Subtitle}" />
                <Setter Property="FontWeight" Value="{DynamicResource Token.Weight.Medium}" />
                <Setter Property="Margin" Value="{DynamicResource Token.Thickness.Sm}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Token.Color.Brand.Primary}" />
                <Setter Property="Foreground" Value="{DynamicResource Token.Color.Text.Inverse}" />
                <Setter Property="Padding" Value="{DynamicResource Token.Thickness.Sm}" />
                <Setter Property="Margin" Value="{DynamicResource Token.Thickness.Xs}" />
                <Setter Property="FontSize" Value="{DynamicResource Token.Font.Body}" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource Token.Color.Surface.Raised}" />
                <Setter Property="Foreground" Value="{DynamicResource Token.Color.Text.Primary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Token.Color.Text.Secondary}" />
                <Setter Property="Padding" Value="{DynamicResource Token.Thickness.Xs}" />
                <Setter Property="Margin" Value="{DynamicResource Token.Thickness.Xs}" />
                <Setter Property="FontSize" Value="{DynamicResource Token.Font.Body}" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{DynamicResource Token.Color.Text.Primary}" />
                <Setter Property="Background" Value="{DynamicResource Token.Color.Surface.Raised}" />
                <Setter Property="Padding" Value="{DynamicResource Token.Thickness.Xs}" />
                <Setter Property="Margin" Value="{DynamicResource Token.Thickness.Xs}" />
                <Setter Property="FontSize" Value="{DynamicResource Token.Font.Body}" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Token.Color.Text.Primary}" />
                <Setter Property="Margin" Value="{DynamicResource Token.Thickness.Sm}" />
                <Setter Property="FontSize" Value="{DynamicResource Token.Font.Body}" />
            </Style>

            <Style x:Key="RiskBanner" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Token.Color.State.Danger}" />
                <Setter Property="Padding" Value="{DynamicResource Token.Thickness.Md}" />
                <Setter Property="Margin" Value="{DynamicResource Token.Thickness.Md}" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Token.Color.Surface.Raised}" />
                <Setter Property="Padding" Value="{DynamicResource Token.Thickness.Md}" />
                <Setter Property="Margin" Value="{DynamicResource Token.Thickness.Md}" />
                <Setter Property="CornerRadius" Value="{DynamicResource Token.Corner.Md}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>